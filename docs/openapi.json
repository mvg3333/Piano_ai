  "components": {
    "schemas": {
      "Body_upload_api_sources_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_sources_upload_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobInput": {
        "properties": {
          "sourceId": {
            "type": "string",
            "title": "Sourceid"
          },
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start",
            "default": 0
          },
          "end": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "settings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreSettings"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "sourceId"
        ],
        "title": "JobInput"
      },
      "NoteEdit": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "pitch": {
            "type": "integer",
            "maximum": 127.0,
            "minimum": 0.0,
            "title": "Pitch"
          },
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "End"
          },
          "hand": {
            "type": "string",
            "title": "Hand"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "pitch",
          "start",
          "end",
          "hand"
        ],
        "title": "NoteEdit"
      },
      "RevisionInput": {
        "properties": {
          "settings": {
            "$ref": "#/components/schemas/ScoreSettings"
          },
          "edits": {
            "items": {
              "$ref": "#/components/schemas/NoteEdit"
            },
            "type": "array",
            "title": "Edits",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "settings"
        ],
        "title": "RevisionInput"
      },
      "ScoreSettings": {
        "properties": {
          "tempo": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 20.0,
            "title": "Tempo",
            "default": 100
          },
          "numerator": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Numerator",
            "default": 4
          },
          "denominator": {
            "type": "integer",
            "title": "Denominator",
            "default": 4
          },
          "quantization": {
            "type": "string",
            "title": "Quantization",
            "default": "1/16"
          },
          "downbeat": {
            "type": "number",
            "minimum": 0.0,
            "title": "Downbeat",
            "default": 0
          },
          "useMidiTempo": {
            "type": "boolean",
            "title": "Usemiditempo",
            "default": false
          },
          "cleanup": {
            "type": "string",
            "enum": [
              "off",
              "balanced",
              "strong"
            ],
            "title": "Cleanup",
            "default": "balanced"
          }
        },
        "type": "object",
        "title": "ScoreSettings"
      },
      "TitleInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "TitleInput"
      },
      "TranscriptionInput": {
        "properties": {
          "settings": {
            "$ref": "#/components/schemas/ScoreSettings"
          }
        },
        "type": "object",
        "required": [
          "settings"
        ],
        "title": "TranscriptionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "YouTubeInput": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "YouTubeInput"
      }
    }
  }
}